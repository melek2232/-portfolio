<?xml version="1.0" encoding="utf-8"?>
<robot name="robot">

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.0121459734710621 0.000198241570210142 0.0449906840595474" rpy="0 0 0" />
      <mass value="1.00796524149794" />
      <inertia
        ixx="0.000664022840014205"
        ixy="3.36477372709559E-06"
        ixz="-6.46022439037541E-06"
        iyy="0.00190520705036307"
        iyz="5.00471440887707E-10"
        izz="0.00244406959005576" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.STL" />
      </geometry>
      <material name="yellow">
        <color rgba="1 1 0 1" />
      </material>
    </visual>
    <!-- Simple box instead of the mesh (fast, stable physics); sized from the mesh bounding box -->
    <collision>
      <origin xyz="-0.005 0 0.042" rpy="0 0 0" />
      <geometry>
        <box size="0.27 0.15 0.10" />
      </geometry>
    </collision>
  </link>

  <!-- Left Rear Wheel -->
  <link name="left_rear_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0310322138231813" />
      <inertia
        ixx="1.37618924502922E-05"
        ixy="0"
        ixz="0"
        iyy="1.37620600377143E-05"
        iyz="0"
        izz="2.28600342994284E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="leftrearwheel" type="continuous">
    <origin xyz="0.0588 -0.07355 0.011" rpy="-1.5708 0 -3.1416" />
    <parent link="base_link" />
    <child link="left_rear_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- Right Rear Wheel -->
  <link name="right_rear_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0310322138231813" />
      <inertia
        ixx="1.37618924502922E-05"
        ixy="0"
        ixz="0"
        iyy="1.37620600377143E-05"
        iyz="0"
        izz="2.28600342994284E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="rightrearwheel" type="continuous">
    <origin xyz="0.058826 0.07355 0.011" rpy="-1.5708 0 -3.1416" />
    <parent link="base_link" />
    <child link="right_rear_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- Left Front Wheel -->
  <link name="left_front_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0310322138231813" />
      <inertia
        ixx="1.37618924502922E-05"
        ixy="0"
        ixz="0"
        iyy="1.37620600377143E-05"
        iyz="0"
        izz="2.28600342994284E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_front_wheel_joint" type="continuous">
    <origin xyz="-0.058826 -0.07355 0.011" rpy="-1.5708 0 -3.1416" />
    <parent link="base_link" />
    <child link="left_front_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- Right Front Wheel -->
  <link name="right_front_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.0310322138231806" />
      <inertia
        ixx="1.37618924502919E-05"
        ixy="0"
        ixz="0"
        iyy="1.3762060037714E-05"
        iyz="0"
        izz="2.28600342994278E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
      <material name="black">
        <color rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder radius="0.033" length="0.025"/>
      </geometry>
    </collision>
  </link>

  <joint name="rightfrontwheel" type="continuous">
    <origin xyz="-0.0588 0.07355 0.011" rpy="-1.5708 0 -3.1416" />
    <parent link="base_link" />
    <child link="right_front_wheel" />
    <axis xyz="0 0 -1" />
    <limit effort="100" velocity="100" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <!-- LiDAR Link -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.125"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry>
      <material name="lidar_jaune">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="lidar_joint" type="fixed">
    <origin xyz="-0.068 0 0.12" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- Camera Link -->
  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.03"/>
      </geometry>
      <material name="camera_jaune">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_joint" type="fixed">
    <origin xyz="-0.078 0 0.09" rpy="0 0 3.15"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- Camera Optical Frame -->
  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
  </joint>


  <!-- ================= Gazebo (gz-sim) ================= -->
  <gazebo reference="left_rear_wheel"><mu1>0.5</mu1><mu2>0.5</mu2></gazebo>
  <gazebo reference="right_rear_wheel"><mu1>0.5</mu1><mu2>0.5</mu2></gazebo>
  <gazebo reference="left_front_wheel"><mu1>0.5</mu1><mu2>0.5</mu2></gazebo>
  <gazebo reference="right_front_wheel"><mu1>0.5</mu1><mu2>0.5</mu2></gazebo>

  <!-- 2D LiDAR: 360 deg, 10 Hz -> gz topic /scan (bridged to /scan_raw, then relayed to /scan) -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>/scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- 4-wheel skid-steer through the DiffDrive plugin.
       All four wheel joints rotate about +y; a positive rotation moves the robot toward +x.
       The URDF names are given for a robot whose front is -x (camera side), so seen from +x
       the wheels named "right*" (y>0) are on the LEFT: the names are swapped below on purpose.
       Consequence: cmd_vel linear.x > 0 drives toward +x (the lidar/camera side is the rear). -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>rightrearwheel</left_joint>
      <left_joint>rightfrontwheel</left_joint>
      <right_joint>leftrearwheel</right_joint>
      <right_joint>left_front_wheel_joint</right_joint>
      <wheel_separation>0.1471</wheel_separation>
      <wheel_radius>0.033</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
