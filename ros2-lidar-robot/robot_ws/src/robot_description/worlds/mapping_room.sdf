<?xml version="1.0"?>
<sdf version="1.10">
  <world name="mapping_room">
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.85 0.85 0.85 1</ambient><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_n">
      <static>true</static>
      <pose>0 4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.2 0.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.2 0.2 0.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_s">
      <static>true</static>
      <pose>0 -4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>8.2 0.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>8.2 0.2 0.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_e">
      <static>true</static>
      <pose>4 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8.2 0.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_w">
      <static>true</static>
      <pose>-4 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 8.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.2 8.2 0.5</size></box></geometry>
          <material><ambient>0.7 0.7 0.75 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
    </model>
    <model name="partition_1">
      <static>true</static>
      <pose>-1.5 1.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.15 4.0 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.15 4.0 0.5</size></box></geometry>
          <material><ambient>0.6 0.7 0.8 1</ambient><diffuse>0.6 0.7 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="partition_2">
      <static>true</static>
      <pose>1.5 -1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>3.0 0.15 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>3.0 0.15 0.5</size></box></geometry>
          <material><ambient>0.6 0.7 0.8 1</ambient><diffuse>0.6 0.7 0.8 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_1">
      <static>true</static>
      <pose>2.3 2.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 0.8 0.5</size></box></geometry>
          <material><ambient>0.5 0.8 0.5 1</ambient><diffuse>0.5 0.8 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>-2.8 -2.4 0.25 0 0 0.5</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 1.2 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 1.2 0.5</size></box></geometry>
          <material><ambient>0.5 0.8 0.5 1</ambient><diffuse>0.5 0.8 0.5 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_1">
      <static>true</static>
      <pose>0.3 1.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.3 1</ambient><diffuse>0.8 0.4 0.3 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pillar_2">
      <static>true</static>
      <pose>-2.6 2.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.8 0.4 0.3 1</ambient><diffuse>0.8 0.4 0.3 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
