# Settings shared by run_robot.sh (Pi) and the pc/*.sh scripts (PC). Edit here, not in the scripts.
ROS_DOMAIN_ID=42
# Direct cable Pi <-> PC (RJ45): list both addresses if the PC cannot see the Pi's topics.
# ROS_STATIC_PEERS="192.168.50.2;192.168.50.1"
# ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET

# Pi: serial ports (stable names, they do not change after a replug). `ls -l /dev/serial/by-id/`
LIDAR=x2
LIDAR_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0
MEGA_PORT=/dev/serial/by-id/usb-Arduino__www.arduino.cc__Arduino_Mega_2560_12150481010614821365-if00
LIDAR_YAW=0.0          # 3.14159 if the lidar's zero mark points backwards
SPEED=0.12             # explorer speed, m/s
