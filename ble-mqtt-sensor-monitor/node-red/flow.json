  {
    "id": "b716f274c42e4ca0",
    "type": "ui_template",
    "z": "1ac207541b7bd1f1",
    "group": "4bb0c1f81366cc58",
    "name": "rep",
    "order": 0,
    "width": 0,
    "height": 0,
    "format": "<div style=\"background:#111827;color:white;padding:12px;border-radius:12px;font-family:Arial,sans-serif\">\n    <h3 style=\"text-align:center;margin:5px\">Repère 3D — Accéléromètre</h3>\n\n    <canvas id=\"accelCanvas\" style=\"width:100%;height:350px;display:block\">\n    </canvas>\n\n    <div style=\"display:flex;justify-content:space-around;flex-wrap:wrap\">\n        <span style=\"color:#ff6464\">X : <b>{{values.ax}}</b></span>\n        <span style=\"color:#55df83\">Y : <b>{{values.ay}}</b></span>\n        <span style=\"color:#60a5fa\">Z : <b>{{values.az}}</b></span>\n    </div>\n</div>\n\n<script>\n    (function(scope) {\n    scope.values = {ax: 0, ay: 0, az: 0};\n\n    var canvas, ctx;\n    var lastMsg = null;\n\n    function draw() {\n        canvas = document.getElementById(\"accelCanvas\");\n        if (!canvas) return;\n\n        var rect = canvas.getBoundingClientRect();\n        if (!rect.width || !rect.height) return;\n\n        var dpr = window.devicePixelRatio || 1;\n        canvas.width = rect.width * dpr;\n        canvas.height = rect.height * dpr;\n\n        ctx = canvas.getContext(\"2d\");\n        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n\n        var w = rect.width;\n        var h = rect.height;\n        var cx = w / 2;\n        var cy = h / 2 + 15;\n\n        ctx.clearRect(0, 0, w, h);\n\n        // Projection 3D vers 2D\n        function project(x, y, z) {\n            return {\n                x: cx + (x - y) * 0.707 * 100,\n                y: cy + (x + y) * 0.30 * 100 - z * 100\n            };\n        }\n\n        function line(a, b, color, width) {\n            ctx.beginPath();\n            ctx.moveTo(a.x, a.y);\n            ctx.lineTo(b.x, b.y);\n            ctx.strokeStyle = color;\n            ctx.lineWidth = width || 2;\n            ctx.stroke();\n        }\n\n        // Axes X, Y et Z\n        var O = project(0, 0, 0);\n        var X = project(1.5, 0, 0);\n        var Y = project(0, 1.5, 0);\n        var Z = project(0, 0, 1.5);\n\n        line(O, X, \"#ff6464\", 3);\n        line(O, Y, \"#55df83\", 3);\n        line(O, Z, \"#60a5fa\", 3);\n\n        function label(p, txt, color) {\n            ctx.fillStyle = color;\n            ctx.font = \"bold 14px Arial\";\n            ctx.fillText(txt, p.x + 5, p.y - 5);\n        }\n\n        label(X, \"X\");\n        label(Y, \"Y\");\n        label(Z, \"Z\");\n\n        // Valeurs reçues du capteur\n        if (!lastMsg || !lastMsg.payload) return;\n\n        var p = lastMsg.payload;\n        var ax = Number(p.ax);\n        var ay = Number(p.ay);\n        var az = Number(p.az);\n\n        if (![ax, ay, az].every(Number.isFinite)) return;\n\n        // Normalisation pour garder le vecteur visible\n        var magnitude = Math.sqrt(ax*ax + ay*ay + az*az);\n        var scale = magnitude > 0 ? 1.2 / Math.max(1, magnitude) : 1;\n\n        var V = project(ax * scale, ay * scale, az * scale);\n\n        // Vecteur d'accélération\n        line(O, V, \"#facc15\", 4);\n\n        // Pointe du vecteur\n        var angle = Math.atan2(V.y - O.y, V.x - O.x);\n        var arrow = 10;\n\n        ctx.beginPath();\n        ctx.moveTo(V.x, V.y);\n        ctx.lineTo(\n            V.x - arrow * Math.cos(angle - Math.PI / 6),\n            V.y - arrow * Math.sin(angle - Math.PI / 6)\n        );\n        ctx.lineTo(\n            V.x - arrow * Math.cos(angle + Math.PI / 6),\n            V.y - arrow * Math.sin(angle + Math.PI / 6)\n        );\n        ctx.closePath();\n        ctx.fillStyle = \"#facc15\";\n        ctx.fill();\n\n        ctx.fillStyle = \"#facc15\";\n        ctx.font = \"bold 13px Arial\";\n        ctx.fillText(\"Accélération\", V.x + 8, V.y - 8);\n    }\n\n    scope.$watch(\"msg\", function(msg) {\n        if (!msg || !msg.payload) return;\n\n        lastMsg = msg;\n        scope.values = {\n            ax: Number(msg.payload.ax).toFixed(3),\n            ay: Number(msg.payload.ay).toFixed(3),\n            az: Number(msg.payload.az).toFixed(3)\n        };\n\n        setTimeout(draw, 0);\n    });\n\n    scope.$on(\"$destroy\", function() {\n        lastMsg = null;\n    });\n})(scope);\n</script>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 730,
    "y": 240,
    "wires": [
      []
    ]
